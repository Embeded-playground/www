---
import Layout from '../../layouts/Layout.astro';
import DashboardShell from '../../components/dashboard/DashboardShell.astro';

// Baseline campus telemetry metrics for 15 slots at Main Hall
const summaryMetrics = {
  totalServed: '165 Mobil',
  peakOccupancy: '93.3%',
  avgDuration: '1 Jam 25 Mnt',
  turnoverRatio: '5.5x',
};

// Hourly curve bars for 15 slots capacity at Main Hall
const hourlyTrafficBars = [
  { time: '07:00', height: '33%', count: '5 Mobil', pct: '33%', isPeak: false },
  { time: '08:00', height: '60%', count: '9 Mobil', pct: '60%', isPeak: false },
  { time: '09:00', height: '87%', count: '13 Mobil', pct: '87%', isPeak: false },
  { time: '10:00', height: '93%', count: '14 Mobil', pct: '93%', isPeak: true },
  { time: '11:00', height: '80%', count: '12 Mobil', pct: '80%', isPeak: false },
  { time: '12:00', height: '53%', count: '8 Mobil', pct: '53%', isPeak: false },
  { time: '13:00', height: '73%', count: '11 Mobil', pct: '73%', isPeak: false },
  { time: '14:00', height: '67%', count: '10 Mobil', pct: '67%', isPeak: false },
  { time: '15:00', height: '47%', count: '7 Mobil', pct: '47%', isPeak: false },
  { time: '16:00', height: '27%', count: '4 Mobil', pct: '27%', isPeak: false },
  { time: '17:00', height: '13%', count: '2 Mobil', pct: '13%', isPeak: false },
];

// Inflow vs Outflow traffic data
const hourlyFlowData = [
  { time: '07:00', inHeight: '38%', outHeight: '8%', inCount: 5, outCount: 1, net: '+4' },
  { time: '08:00', inHeight: '62%', outHeight: '23%', inCount: 8, outCount: 3, net: '+5' },
  { time: '09:00', inHeight: '77%', outHeight: '31%', inCount: 10, outCount: 4, net: '+6' },
  { time: '10:00', inHeight: '69%', outHeight: '62%', inCount: 9, outCount: 8, net: '+1', isPeak: true },
  { time: '11:00', inHeight: '38%', outHeight: '69%', inCount: 5, outCount: 9, net: '-4' },
  { time: '12:00', inHeight: '31%', outHeight: '85%', inCount: 4, outCount: 11, net: '-7' },
  { time: '13:00', inHeight: '85%', outHeight: '38%', inCount: 11, outCount: 5, net: '+6' },
  { time: '14:00', inHeight: '46%', outHeight: '54%', inCount: 6, outCount: 7, net: '-1' },
  { time: '15:00', inHeight: '23%', outHeight: '62%', inCount: 3, outCount: 8, net: '-5' },
  { time: '16:00', inHeight: '15%', outHeight: '46%', inCount: 2, outCount: 6, net: '-4' },
  { time: '17:00', inHeight: '8%', outHeight: '23%', inCount: 1, outCount: 3, net: '-2' },
];

// Average Wait Time to find bay (in minutes)
const waitTimeData = [
  { time: '07:00', mins: '0.8 mnt', fill: '18%' },
  { time: '08:00', mins: '2.1 mnt', fill: '45%' },
  { time: '09:00', mins: '3.6 mnt', fill: '78%' },
  { time: '10:00', mins: '4.6 mnt', fill: '100%', isPeak: true },
  { time: '11:00', mins: '2.4 mnt', fill: '52%' },
  { time: '12:00', mins: '1.4 mnt', fill: '30%' },
  { time: '13:00', mins: '3.1 mnt', fill: '67%' },
  { time: '14:00', mins: '1.9 mnt', fill: '41%' },
  { time: '15:00', mins: '1.1 mnt', fill: '24%' },
  { time: '16:00', mins: '0.5 mnt', fill: '11%' },
];

// Weekly traffic trends across academic days
const weeklyTrends = [
  { day: 'Senin', count: '172 Mobil', pct: 95, note: 'Kuliah Umum & Registrasi Awal Pekan' },
  { day: 'Selasa', count: '165 Mobil', pct: 91, isToday: true, note: 'Hari Ini (Beban Terkendali)' },
  { day: 'Rabu', count: '180 Mobil', pct: 100, isPeak: true, note: 'Puncak Praktikum & Sidang Jurusan' },
  { day: 'Kamis', count: '155 Mobil', pct: 86, note: 'Sesi Kuliah Reguler S1' },
  { day: 'Jumat', count: '118 Mobil', pct: 65, note: 'Sesi Kuliah Pendek & Keagamaan' },
];

// Main Hall Sector Utilization
const sectorBreakdown = [
  { name: 'Baris Depan (Slot 01 - 05)', occupied: 3, total: 5, pct: 60, turnover: '6.2x', desc: 'Akses terdekat ke pintu masuk Main Hall' },
  { name: 'Baris Tengah (Slot 06 - 10)', occupied: 4, total: 5, pct: 80, turnover: '5.4x', desc: 'Sektor parkir reguler mahasiswa & dosen' },
  { name: 'Baris Belakang (Slot 11 - 15)', occupied: 4, total: 5, pct: 80, turnover: '4.8x', desc: 'Sektor durasi parkir lebih dari 2 jam' },
];

// Duration distribution
const durationBrackets = [
  { label: '< 30 Menit (Drop-off & Kurir)', pct: 28, count: '46 Mobil', color: 'bg-slot-available' },
  { label: '1 - 2 Jam (Sesi Kuliah Reguler)', pct: 44, count: '73 Mobil', color: 'bg-primary' },
  { label: '2 - 4 Jam (Dosen & Laboratorium)', pct: 20, count: '33 Mobil', color: 'bg-amber-600' },
  { label: '> 4 Jam (Staf & Acara Kampus)', pct: 8, count: '13 Mobil', color: 'bg-slot-occupied' },
];

// Telemetry logs for 15 bays at Main Hall
const initialTelemetryRows = [
  { time: '07:30 WIB', location: 'Main Hall (Baris Depan)', occupancy: '40% (2/5)', status: 'Lancar', statusClass: 'bg-slot-available/10 text-slot-available', recommendation: 'Akses gerbang pintu masuk utama lancar.' },
  { time: '08:45 WIB', location: 'Main Hall (Baris Depan)', occupancy: '80% (4/5)', status: 'Mendekati Puncak', statusClass: 'bg-primary/10 text-primary', recommendation: 'Sisa 1 slot kosong (Slot 02).' },
  { time: '09:30 WIB', location: 'Main Hall (Total 15 Slot)', occupancy: '93.3% (14/15)', status: 'Puncak', statusClass: 'bg-slot-occupied/10 text-slot-occupied', recommendation: 'VMS aktif: arahkan ke Slot 05 & 09.' },
  { time: '10:15 WIB', location: 'Main Hall (Baris Tengah)', occupancy: '80% (4/5)', status: 'Terkendali', statusClass: 'bg-slot-available/10 text-slot-available', recommendation: 'Slot 09 siap ditempati kendaraan baru.' },
  { time: '11:45 WIB', location: 'Main Hall (Baris Belakang)', occupancy: '80% (4/5)', status: 'Optimal', statusClass: 'bg-slot-available/10 text-slot-available', recommendation: 'Slot 14 siap ditempati pengajar.' },
  { time: '13:30 WIB', location: 'Main Hall (Total 15 Slot)', occupancy: '73.3% (11/15)', status: 'Normal', statusClass: 'bg-slot-available/10 text-slot-available', recommendation: 'Rotasi perkuliahan sesi siang berjalan lancar.' },
];
---

<Layout title="Analisis Trafik &amp; Alokasi Lahan · GoParkir Campus CV Monitoring">
  <DashboardShell activeNavId="analytics">
    
    <!-- Top Action Header (Saku Style: Balanced & Never Wrapping) -->
    <header class="mb-6 md:mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex-1 min-w-0 pr-4">
          <div class="flex items-center gap-2 mb-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-slot-available animate-pulse"></span>
            <span class="text-xs font-mono text-primary font-bold uppercase tracking-wider">
              Lokasi: Main Hall Kampus (15 Slot)
            </span>
          </div>
          <h2 class="font-headline text-2xl sm:text-3xl md:text-4xl font-medium text-on-surface tracking-tight">
            Analisis Trafik &amp; Alokasi Lahan Kampus
          </h2>
          <p class="font-body text-on-surface-variant mt-1 text-xs sm:text-sm md:text-base">
            Audit telemetri YOLO26m, kurva arus masuk/keluar, dan kapasitas 15 bay Main Hall.
          </p>
        </div>

        <!-- Action Buttons: Side-by-side, Never Stacking -->
        <div class="flex items-center gap-2.5 shrink-0 flex-nowrap self-start sm:self-auto">
          <!-- Generate AI Button -->
          <button
            type="button"
            id="btn-generate-ai"
            class="flex items-center gap-2 px-4 py-2.5 rounded-full bg-primary text-on-primary font-body font-semibold text-xs md:text-sm hover:bg-primary-container transition-all shadow-xs cursor-pointer active:scale-95 whitespace-nowrap group min-h-[42px]"
          >
            <span class="material-symbols-outlined text-base group-hover:rotate-45 transition-transform" style="font-variation-settings: 'FILL' 1;">
              auto_awesome
            </span>
            <span id="btn-generate-ai-text">Generate AI</span>
          </button>

          <!-- Export PDF Button -->
          <button
            type="button"
            id="btn-open-pdf-modal"
            class="flex items-center gap-2 px-4 py-2.5 rounded-full bg-surface-container-highest hover:bg-surface-container-high text-on-surface font-body font-semibold text-xs md:text-sm transition-all border border-outline-variant/20 shadow-xs cursor-pointer active:scale-95 whitespace-nowrap min-h-[42px]"
          >
            <span class="material-symbols-outlined text-base text-primary">
              picture_as_pdf
            </span>
            <span>Export PDF</span>
          </button>
        </div>
      </div>

      <!-- Filter Controls: Segmented Pills & Custom Dropdowns -->
      <div class="mt-6 pt-6 border-t border-outline-variant/10 flex flex-wrap items-center justify-between gap-4">
        
        <!-- Segmented Period Pills -->
        <div class="inline-flex items-center p-1.5 rounded-full bg-surface-container-low border border-outline-variant/15 text-xs font-mono">
          <button
            type="button"
            class="period-filter-pill px-4 py-1.5 rounded-full bg-surface-container-highest text-primary font-bold shadow-xs cursor-pointer transition-all"
            data-period="today"
          >
            Hari Ini
          </button>
          <button
            type="button"
            class="period-filter-pill px-4 py-1.5 rounded-full text-secondary hover:text-on-surface hover:bg-surface-container-highest/50 transition-all cursor-pointer"
            data-period="week"
          >
            Minggu Ini
          </button>
          <button
            type="button"
            class="period-filter-pill px-4 py-1.5 rounded-full text-secondary hover:text-on-surface hover:bg-surface-container-highest/50 transition-all cursor-pointer"
            data-period="month"
          >
            Bulan Ini
          </button>
        </div>

        <!-- Custom Dropdown Filters -->
        <div class="flex flex-wrap items-center gap-3">
          
          <!-- Custom Dropdown: Baris Main Hall -->
          <div class="relative custom-dropdown" id="dropdown-sector" data-active-value="all">
            <button
              type="button"
              class="custom-dropdown-btn flex items-center justify-between gap-3 px-4 py-2 min-h-[40px] rounded-full bg-surface-container-low border border-outline-variant/20 hover:border-primary/40 text-xs font-mono text-on-surface cursor-pointer transition-all shadow-xs"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="custom-dropdown-label truncate">Semua Baris Main Hall (1-15)</span>
              <span class="material-symbols-outlined text-base text-on-surface-variant transition-transform custom-dropdown-chevron">
                expand_more
              </span>
            </button>
            <div class="custom-dropdown-panel hidden absolute right-0 top-full mt-2 w-60 bg-surface-container-lowest rounded-2xl shadow-[0_16px_40px_rgba(27,28,24,0.14)] border border-outline-variant/20 p-1.5 z-40">
              <button type="button" class="custom-dropdown-item w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-mono text-primary font-bold bg-surface-container-highest hover:bg-surface-container-high transition-colors text-left cursor-pointer" data-value="all">
                <span>Semua Baris Main Hall (1-15)</span>
                <span class="material-symbols-outlined text-sm">check</span>
              </button>
              <button type="button" class="custom-dropdown-item w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-mono text-on-surface hover:bg-surface-container-highest transition-colors text-left cursor-pointer" data-value="baris-depan">
                <span>Baris Depan (Slot 01 - 05)</span>
              </button>
              <button type="button" class="custom-dropdown-item w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-mono text-on-surface hover:bg-surface-container-highest transition-colors text-left cursor-pointer" data-value="baris-tengah">
                <span>Baris Tengah (Slot 06 - 10)</span>
              </button>
              <button type="button" class="custom-dropdown-item w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-mono text-on-surface hover:bg-surface-container-highest transition-colors text-left cursor-pointer" data-value="baris-belakang">
                <span>Baris Belakang (Slot 11 - 15)</span>
              </button>
            </div>
          </div>

          <!-- Custom Dropdown: Fokus Laporan -->
          <div class="relative custom-dropdown" id="dropdown-focus" data-active-value="jam-sibuk">
            <button
              type="button"
              class="custom-dropdown-btn flex items-center justify-between gap-3 px-4 py-2 min-h-[40px] rounded-full bg-surface-container-low border border-outline-variant/20 hover:border-primary/40 text-xs font-mono text-on-surface cursor-pointer transition-all shadow-xs"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="custom-dropdown-label truncate">Fokus: Jam Sibuk Kuliah</span>
              <span class="material-symbols-outlined text-base text-on-surface-variant transition-transform custom-dropdown-chevron">
                expand_more
              </span>
            </button>
            <div class="custom-dropdown-panel hidden absolute right-0 top-full mt-2 w-64 bg-surface-container-lowest rounded-2xl shadow-[0_16px_40px_rgba(27,28,24,0.14)] border border-outline-variant/20 p-1.5 z-40">
              <button type="button" class="custom-dropdown-item w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-mono text-primary font-bold bg-surface-container-highest hover:bg-surface-container-high transition-colors text-left cursor-pointer" data-value="jam-sibuk">
                <span>Fokus: Jam Sibuk Kuliah</span>
                <span class="material-symbols-outlined text-sm">check</span>
              </button>
              <button type="button" class="custom-dropdown-item w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-mono text-on-surface hover:bg-surface-container-highest transition-colors text-left cursor-pointer" data-value="rotasi-lahan">
                <span>Fokus: Rotasi &amp; Kapasitas</span>
              </button>
              <button type="button" class="custom-dropdown-item w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-mono text-on-surface hover:bg-surface-container-highest transition-colors text-left cursor-pointer" data-value="efisiensi-emisi">
                <span>Fokus: Emisi &amp; Karbon</span>
              </button>
            </div>
          </div>

        </div>
      </div>
    </header>

    <!-- AI Generation Progress Indicator -->
    <div id="ai-progress-container" class="hidden mb-6 bg-surface-container-lowest rounded-2xl p-6 border border-primary/20 shadow-lg animate-in">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
          <span class="material-symbols-outlined text-xl animate-spin">sync</span>
        </div>
        <div class="flex-1">
          <h4 class="font-headline font-semibold text-sm text-on-surface" id="ai-progress-title">
            Gemini Campus Engine sedang menganalisis telemetri...
          </h4>
          <p class="text-xs text-on-surface-variant font-mono mt-0.5" id="ai-progress-status">
            Membaca ground contact points pada 15 bay Main Hall...
          </p>
          <div class="w-full bg-surface-container-highest h-1.5 rounded-full mt-2.5 overflow-hidden">
            <div id="ai-progress-bar" class="h-full bg-primary transition-all duration-300 rounded-full" style="width: 25%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- COMPACT AI ADVISOR BANNER (SAKU INSIGHTCARD STYLE: TOP)  -->
    <!-- ======================================================== -->
    <section class="bg-surface-container-lowest rounded-2xl p-6 sm:p-7 relative overflow-hidden group shadow-[0_4px_16px_rgba(27,28,24,0.02)] border border-outline-variant/15 mb-6">
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-[radial-gradient(circle,rgba(154,64,33,0.12)_0%,transparent_70%)] rounded-full blur-2xl pointer-events-none"></div>
      
      <div class="flex items-start gap-4 relative z-10">
        <div class="h-11 w-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-primary text-2xl" style="font-variation-settings: 'FILL' 1;">
            auto_awesome
          </span>
        </div>
        
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
            <h3 class="font-headline text-xl sm:text-2xl font-medium text-on-surface">
              Executive AI Synthesis &amp; Alokasi Lahan
            </h3>
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-primary/10 text-primary">
                Akurasi 99.4%
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-surface-container-high text-secondary">
                Real-Time 30 FPS
              </span>
            </div>
          </div>

          <div id="ai-narrative-content" class="font-body text-sm text-on-surface-variant leading-relaxed space-y-2">
            <p>
              Tingkat okupansi Main Hall mencapai <strong class="text-on-surface">73.3%</strong> dengan lonjakan puncak <strong class="text-on-surface">93.3% (14/15 mobil)</strong> pada jam sibuk 10:00 WIB. Sistem VMS memprioritaskan pengalihan pengemudi baru ke <strong class="text-on-surface">Slot 02</strong> dan <strong class="text-on-surface">Slot 05</strong>, mereduksi waktu tunggu dari 4.6 menit ke 1.1 menit.
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-outline-variant/10 flex flex-wrap items-center gap-4 text-xs font-mono">
            <span class="text-on-surface-variant flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-slot-available"></span>
              <span>1 Booth Bazar BEM Terisolasi Aman</span>
            </span>
            <span class="text-on-surface-variant flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-600"></span>
              <span>Slot 10 Pemeliharaan Sensor</span>
            </span>
            <span class="text-primary font-bold ml-auto flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">energy_savings_leaf</span>
              <span>Hemat ~14.2L BBM/Hari</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 Key Analytics KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-8">
      <div class="bg-surface-container-low rounded-xl p-5 hover:bg-surface-container transition-colors shadow-xs">
        <span class="text-[10px] font-mono uppercase text-on-surface-variant block mb-1">Total Kendaraan Terlayani</span>
        <p class="font-headline text-2xl sm:text-3xl font-bold text-primary" id="kpi-total-served">
          {summaryMetrics.totalServed}
        </p>
        <span class="text-xs text-on-surface-variant font-mono mt-1 block">Rotasi 15 Slot Main Hall</span>
      </div>

      <div class="bg-surface-container-low rounded-xl p-5 hover:bg-surface-container transition-colors shadow-xs">
        <span class="text-[10px] font-mono uppercase text-on-surface-variant block mb-1">Puncak Okupansi Lahan</span>
        <p class="font-headline text-2xl sm:text-3xl font-bold text-slot-occupied mt-0.5" id="kpi-peak-occupancy">
          {summaryMetrics.peakOccupancy}
        </p>
        <span class="text-xs text-on-surface-variant font-mono mt-1 block">14 / 15 Slot (10:00 WIB)</span>
      </div>

      <div class="bg-surface-container-low rounded-xl p-5 hover:bg-surface-container transition-colors shadow-xs">
        <span class="text-[10px] font-mono uppercase text-on-surface-variant block mb-1">Rata-rata Durasi Parkir</span>
        <p class="font-headline text-2xl sm:text-3xl font-bold text-on-surface mt-0.5">
          {summaryMetrics.avgDuration}
        </p>
        <span class="text-xs text-slot-available font-mono font-bold mt-1 block">Optimal Sesi Kuliah</span>
      </div>

      <div class="bg-surface-container-low rounded-xl p-5 hover:bg-surface-container transition-colors shadow-xs">
        <span class="text-[10px] font-mono uppercase text-on-surface-variant block mb-1">Turnover Ratio Per Bay</span>
        <p class="font-headline text-2xl sm:text-3xl font-bold text-tertiary mt-0.5">
          {summaryMetrics.turnoverRatio}
        </p>
        <span class="text-xs text-on-surface-variant font-mono mt-1 block">Per Hari Kerja Kampus</span>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- DETAILED TRAFFIC CHARTS (PROMINENT & VISIBLE FRONT-CENTER)-->
    <!-- ======================================================== -->
    <div class="space-y-8 mb-10">
      
      <!-- GRAPH 1: Kurva Kepadatan Jam Puncak (Bar Chart Saku Style) -->
      <section class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 shadow-[0_4px_16px_rgba(27,28,24,0.02)] border border-outline-variant/10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="material-symbols-outlined text-primary text-xl">bar_chart</span>
              <h3 class="font-headline text-xl sm:text-2xl font-medium text-on-surface">
                1. Kurva Kepadatan &amp; Okupansi Main Hall per Jam
              </h3>
            </div>
            <p class="font-body text-xs sm:text-sm text-on-surface-variant">
              Tingkat okupansi dan jumlah kendaraan aktif di 15 slot Main Hall sepanjang jam operasional (07:00 - 17:00 WIB)
            </p>
          </div>
          <div class="text-left sm:text-right">
            <span class="font-headline text-2xl text-primary font-bold">14 / 15 Mobil</span>
            <span class="block text-xs font-mono text-on-surface-variant">Puncak Beban Jam 10:00 (93.3%)</span>
          </div>
        </div>

        <!-- CSS Bar Chart with Interactive Tooltips & Capacity Line -->
        <div class="relative h-60 flex items-end justify-between gap-2 md:gap-3 pt-8 border-b border-surface-container-highest pb-4">
          <!-- 100% Capacity Threshold Line -->
          <div class="absolute top-8 left-0 right-0 border-b border-dashed border-slot-occupied/40 pointer-events-none z-10 flex items-center justify-between text-[10px] font-mono text-slot-occupied px-2">
            <span>Batas Kapasitas Penuh (15 Slot)</span>
            <span>100%</span>
          </div>

          {hourlyTrafficBars.map((bar) => (
            <div class="w-full flex flex-col items-center h-full justify-end group relative cursor-pointer">
              <!-- Tooltip on hover -->
              <div class="absolute -top-12 left-1/2 -translate-x-1/2 bg-near-black text-white text-[11px] font-mono py-1.5 px-2.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-20 pointer-events-none shadow-md">
                <span class="font-bold text-amber-300">{bar.time}</span>: {bar.count} ({bar.pct} Okupansi)
              </div>
              
              <!-- Bar Column -->
              <div
                class={`w-full rounded-t-md transition-all duration-300 ${
                  bar.isPeak
                    ? 'bg-primary group-hover:bg-primary-container shadow-xs'
                    : 'bg-surface-container-highest hover:bg-primary/50'
                }`}
                style={`height: ${bar.height}; min-height: 12px;`}
