                <tr>
                  <th class="p-3 border-b border-outline-variant/20">Sektor / Baris</th>
                  <th class="p-3 border-b border-outline-variant/20">Kapasitas</th>
                  <th class="p-3 border-b border-outline-variant/20">Terisi</th>
                  <th class="p-3 border-b border-outline-variant/20">Tingkat Okupansi</th>
                  <th class="p-3 border-b border-outline-variant/20 text-right">Turnover</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-outline-variant/10 font-mono">
                <tr>
                  <td class="p-3 font-headline font-semibold text-on-surface">Baris Depan (Slot 01 - 05)</td>
                  <td class="p-3">5 Slot</td>
                  <td class="p-3">3 Mobil</td>
                  <td class="p-3 font-semibold text-primary">60%</td>
                  <td class="p-3 text-right">6.2x / hari</td>
                </tr>
                <tr>
                  <td class="p-3 font-headline font-semibold text-on-surface">Baris Tengah (Slot 06 - 10)</td>
                  <td class="p-3">5 Slot</td>
                  <td class="p-3">4 Mobil</td>
                  <td class="p-3 font-semibold text-amber-600">80%</td>
                  <td class="p-3 text-right">5.4x / hari</td>
                </tr>
                <tr>
                  <td class="p-3 font-headline font-semibold text-on-surface">Baris Belakang (Slot 11 - 15)</td>
                  <td class="p-3">5 Slot</td>
                  <td class="p-3">4 Mobil</td>
                  <td class="p-3 font-semibold text-amber-600">80%</td>
                  <td class="p-3 text-right">4.8x / hari</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- 4. Strategic Recommendations -->
        <section class="mb-10">
          <h2 class="text-base font-headline font-medium text-on-surface mb-4 flex items-center gap-3">
            <span>Rekomendasi Strategis AI</span>
            <span class="h-[1px] flex-1 bg-outline-variant/30"></span>
          </h2>
          <div class="space-y-3 text-xs leading-relaxed text-on-surface-variant font-body">
            <div class="flex items-start gap-2.5">
              <span class="w-4 h-4 rounded-full bg-primary/10 text-primary font-mono text-[10px] flex items-center justify-center shrink-0 mt-0.5 font-bold">1</span>
              <p><strong class="text-on-surface">Arahkan Arus Masuk Lebih Awal:</strong> Aktifkan display VMS di gerbang pintu depan saat okupansi menyentuh 80% (12/15) untuk memandu pengemudi langsung ke Slot 02 atau Slot 05.</p>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-4 h-4 rounded-full bg-primary/10 text-primary font-mono text-[10px] flex items-center justify-center shrink-0 mt-0.5 font-bold">2</span>
              <p><strong class="text-on-surface">Optimasi Slot Reservasi:</strong> Slot yang dialokasikan untuk booth bazar acara kampus tetap tercatat di sistem telemetri sehingga tidak memicu false-positive alarm parkir liar.</p>
            </div>
          </div>
        </section>

        <!-- 5. Document Signatures Footer -->
        <footer class="mt-auto pt-8 border-t border-outline-variant/20 flex justify-between items-end text-xs font-mono">
          <div>
            <div class="text-[10px] text-on-surface-variant uppercase mb-6">Disiapkan Oleh:</div>
            <div class="font-bold text-on-surface">pavelc4</div>
            <div class="text-on-surface-variant text-[11px]">Lead AI Engineer &bull; GoParkir Lab</div>
          </div>
          <div class="text-right">
            <div class="text-[10px] text-on-surface-variant uppercase mb-6">Disetujui Oleh:</div>
            <div class="font-bold text-on-surface">Bagian Sarana &amp; Prasarana</div>
            <div class="text-on-surface-variant text-[11px]">Biro Administrasi Umum Kampus</div>
          </div>
        </footer>
      </article>

    </div>
  </div>
</div>

<script>
  function setupAnalyticsPage() {
    // 1. Period Filter Pills
    const periodPills = document.querySelectorAll('.period-filter-pill');
    periodPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        periodPills.forEach((p) => {
          p.classList.remove('bg-surface-container-highest', 'text-primary', 'font-bold', 'shadow-xs');
          p.classList.add('text-secondary');
        });
        pill.classList.remove('text-secondary');
        pill.classList.add('bg-surface-container-highest', 'text-primary', 'font-bold', 'shadow-xs');

        const period = pill.getAttribute('data-period');
        updatePeriodData(period || 'today');
      });
    });

    function updatePeriodData(period: string) {
      const kpiServed = document.getElementById('kpi-total-served');
      const kpiPeak = document.getElementById('kpi-peak-occupancy');
      const docPeriod = document.getElementById('report-period-text');

      if (period === 'today') {
        if (kpiServed) kpiServed.textContent = '165 Mobil';
        if (kpiPeak) kpiPeak.textContent = '93.3%';
        if (docPeriod) docPeriod.textContent = 'Periode: Hari Ini (23 Nov 2026)';
      } else if (period === 'week') {
        if (kpiServed) kpiServed.textContent = '790 Mobil';
        if (kpiPeak) kpiPeak.textContent = '100% (Rabu)';
        if (docPeriod) docPeriod.textContent = 'Periode: Minggu Aktif (17 - 23 Nov 2026)';
      } else {
        if (kpiServed) kpiServed.textContent = '3.420 Mobil';
        if (kpiPeak) kpiPeak.textContent = '93.3%';
        if (docPeriod) docPeriod.textContent = 'Periode: Bulan November 2026';
      }
    }

    // 2. Custom Dropdowns
    const dropdowns = document.querySelectorAll('.custom-dropdown');
    dropdowns.forEach((dd) => {
      const btn = dd.querySelector('.custom-dropdown-btn') as HTMLElement;
      const panel = dd.querySelector('.custom-dropdown-panel') as HTMLElement;
      const chevron = dd.querySelector('.custom-dropdown-chevron') as HTMLElement;
      const label = dd.querySelector('.custom-dropdown-label') as HTMLElement;
      const items = dd.querySelectorAll('.custom-dropdown-item');

      if (!btn || !panel) return;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = panel.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) {
          panel.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          if (chevron) chevron.style.transform = 'rotate(180deg)';
        }
      });

      items.forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = item.getAttribute('data-value') || '';
          const text = item.querySelector('span')?.textContent || '';
          if (label) label.textContent = text;
          dd.setAttribute('data-active-value', val);

          items.forEach((i) => {
            i.classList.remove('bg-surface-container-highest', 'text-primary', 'font-bold');
            i.classList.add('text-on-surface');
            const check = i.querySelector('.material-symbols-outlined');
            if (check) check.remove();
          });
          item.classList.add('bg-surface-container-highest', 'text-primary', 'font-bold');
          item.classList.remove('text-on-surface');
          const checkIcon = document.createElement('span');
          checkIcon.className = 'material-symbols-outlined text-sm';
          checkIcon.textContent = 'check';
          item.appendChild(checkIcon);

          panel.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.style.transform = 'rotate(0deg)';
        });
      });
    });

    function closeAllDropdowns() {
      dropdowns.forEach((dd) => {
        const panel = dd.querySelector('.custom-dropdown-panel') as HTMLElement;
        const btn = dd.querySelector('.custom-dropdown-btn') as HTMLElement;
        const chevron = dd.querySelector('.custom-dropdown-chevron') as HTMLElement;
        if (panel) panel.classList.add('hidden');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (chevron) chevron.style.transform = 'rotate(0deg)';
      });
    }

    document.addEventListener('click', closeAllDropdowns);

    // 3. AI Generation Engine Simulation
    const btnGenerateAI = document.getElementById('btn-generate-ai');
    const btnGenerateText = document.getElementById('btn-generate-ai-text');
    const aiProgress = document.getElementById('ai-progress-container');
    const aiProgressBar = document.getElementById('ai-progress-bar');
    const aiProgressStatus = document.getElementById('ai-progress-status');
    const aiContent = document.getElementById('ai-narrative-content');

    btnGenerateAI?.addEventListener('click', () => {
      if (!aiProgress || !aiProgressBar || !aiProgressStatus) return;

      if (btnGenerateText) btnGenerateText.textContent = 'Menganalisis...';
      aiProgress.classList.remove('hidden');
      aiProgressBar.style.width = '15%';
      aiProgressStatus.textContent = 'Membaca ground contact points pada 15 bay Main Hall...';

      // Scroll smoothly to AI section
      aiProgress.scrollIntoView({ behavior: 'smooth', block: 'center' });

      setTimeout(() => {
        if (aiProgressBar) aiProgressBar.style.width = '55%';
        if (aiProgressStatus) aiProgressStatus.textContent = 'Mengevaluasi turnover ratio Baris Depan, Tengah, & Belakang...';
      }, 500);

      setTimeout(() => {
        if (aiProgressBar) aiProgressBar.style.width = '85%';
        if (aiProgressStatus) aiProgressStatus.textContent = 'Menyusun rekomendasi penataan booth & rambu VMS gerbang...';
      }, 1000);

      setTimeout(() => {
        if (aiProgressBar) aiProgressBar.style.width = '100%';
        if (aiProgressStatus) aiProgressStatus.textContent = 'Sintesis selesai!';
        
        setTimeout(() => {
          aiProgress.classList.add('hidden');
          if (btnGenerateText) btnGenerateText.textContent = 'Generate AI';

          if (aiContent) {
            aiContent.innerHTML = `
              <p class="animate-in">
                <strong>Update Real-Time Analisis Gemini:</strong> Telemetri 15 bay Main Hall menunjukkan tingkat keterisian stabil pada <strong>73.3%</strong>. Baris Depan (Slot 01 - 05) melayani 60% okupansi dengan laju rotasi 6.2x berkat kemudahan akses pintu utama gedung.
              </p>
              <p class="animate-in">
                <strong>Status Slot Khusus:</strong> 1 slot reservasi booth bazar Dies Natalis BEM (Slot 03) terpantau aktif dan tidak mengganggu sirkulasi kendaraan masuk. Slot 10 dalam status pemeliharaan sensor roda dan diproteksi otomatis dari penetapan rute pengemudi.
              </p>
              <p class="animate-in">
                <strong>Rekomendasi VMS Siang:</strong> Alihkan pengemudi baru menuju Slot 02 dan Slot 05 untuk meminimalkan waktu putar mencari parkir, menghemat rata-rata 3.4 menit per pengemudi di sesi perkuliahan siang.
              </p>
            `;
          }
        }, 400);
      }, 1500);
    });

    // 4. Modal PDF Preview & Download
    const modalPdf = document.getElementById('modal-pdf-preview');
    const modalBox = document.getElementById('modal-pdf-box');
    const btnOpenModal = document.getElementById('btn-open-pdf-modal');
    const btnCloseModal = document.getElementById('btn-close-pdf-modal');
    const btnDownloadPdf = document.getElementById('btn-download-pdf');
    const btnDownloadText = document.getElementById('btn-download-pdf-text');
    const btnPrintPdf = document.getElementById('btn-print-pdf');

    function openPdfModal() {
      if (!modalPdf || !modalBox) return;
      modalPdf.classList.remove('opacity-0', 'pointer-events-none');
      modalBox.classList.remove('scale-95');
      modalBox.classList.add('scale-100');
    }

    function closePdfModal() {
      if (!modalPdf || !modalBox) return;
      modalBox.classList.remove('scale-100');
      modalBox.classList.add('scale-95');
      modalPdf.classList.add('opacity-0', 'pointer-events-none');
    }

    btnOpenModal?.addEventListener('click', openPdfModal);
    btnCloseModal?.addEventListener('click', closePdfModal);

    modalPdf?.addEventListener('click', (e) => {
      if (e.target === modalPdf) closePdfModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalPdf && !modalPdf.classList.contains('pointer-events-none')) {
        closePdfModal();
      }
    });

    // Print button
    btnPrintPdf?.addEventListener('click', () => {
      window.print();
    });

    // Download PDF with html2pdf.js dynamically loaded
    btnDownloadPdf?.addEventListener('click', async () => {
      const element = document.getElementById('report-document');
      if (!element) return;

      if (btnDownloadText) btnDownloadText.textContent = 'Menyiapkan PDF...';

      try {
        if (!(window as any).html2pdf) {
          await new Promise<void>((resolve, reject) => {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('Gagal memuat library html2pdf'));
            document.head.appendChild(script);
          });
        }

        const opt = {
          margin: [8, 8, 8, 8],
          filename: `GoParkir_Laporan_MainHall_${new Date().toISOString().slice(0, 10)}.pdf`,
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale: 2, useCORS: true, logging: false },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        await (window as any).html2pdf().set(opt).from(element).save();

        if (btnDownloadText) btnDownloadText.textContent = 'PDF Terunduh!';
        setTimeout(() => {
          if (btnDownloadText) btnDownloadText.textContent = 'Unduh File PDF';
        }, 2500);
      } catch (err) {
        console.warn('Fallback to print dialog:', err);
        window.print();
        if (btnDownloadText) btnDownloadText.textContent = 'Unduh File PDF';
      }
    });
  }

  setupAnalyticsPage();
  document.addEventListener('astro:page-load', setupAnalyticsPage);
</script>
