---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import UserRecommendation from '../components/UserRecommendation.astro';
import AdminAnalytics from '../components/AdminAnalytics.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Team from '../components/Team.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="GoParkir · Computer Vision Campus Parking Recommendation & Analytics">
  <Navbar />
  <main class="flex-grow">
    <!-- 1. Hero: Cerita Masalah Kampus & Rekomendasi Mahasiswa -->
    <Hero />

    <!-- 2. FITUR USER: Hanya Rekomendasi Slot Parkir Langsung + Animasi Mobil Masuk/Keluar -->
    <UserRecommendation />

    <!-- 3. FITUR KHUSUS ADMIN: Portal Eksklusif Trafik Jam Sibuk & Keputusan Lahan -->
    <AdminAnalytics />

    <!-- 4. Arsitektur Aliran Data (Python -> Golang -> Astro JS) -->
    <HowItWorks />

    <!-- 5. The Architects: Tim Pengembang Embeded-playground -->
    <Team />
  </main>
  <!-- 6. Footer Khas Saku -->
  <Footer />
</Layout>
