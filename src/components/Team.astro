  {
    name: "Dimas Dwi Ariyanto",
    login: "pavelc4",
    avatar: "https://avatars.githubusercontent.com/u/94319420?v=4",
    github: "https://github.com/pavelc4"
  },
  {
    name: "Morenno Rafael",
    login: "MorennoRafael",
    avatar: "https://avatars.githubusercontent.com/u/171573783?v=4",
    github: "https://github.com/MorennoRafael"
  },
  {
    name: "Dyaksa",
    login: "xdyaksa",
    avatar: "https://avatars.githubusercontent.com/u/118631438?v=4",
    github: "https://github.com/xdyaksa"
  },
  {
    name: "Fauzi",
    login: "fauzi113-maker",
    avatar: "https://avatars.githubusercontent.com/u/335473632?v=4",
    github: "https://github.com/fauzi113-maker"
  },
  {
    name: "Haidar",
    login: "Haidar126",
    avatar: "https://avatars.githubusercontent.com/u/335463357?v=4",
    github: "https://github.com/Haidar126"
  },
