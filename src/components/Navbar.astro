---
---

<header class="w-full bg-[#fbf9f2]/95 backdrop-blur-md sticky top-0 z-50 border-b border-outline-variant/15 transition-all">
  <div class="w-full max-w-screen-2xl mx-auto px-4 sm:px-6 md:px-12 py-3.5 sm:py-4 flex items-center justify-between">
    
    <!-- Brand Title: GoParkir -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-xl bg-primary text-on-primary flex items-center justify-center font-bold text-sm shadow-2xs group-hover:scale-105 transition-transform">
        G
      </div>
      <span class="font-headline text-2xl font-bold tracking-tight text-primary">
        GoParkir
      </span>
    </a>

    <!-- Desktop Navigation Links (Murni Publik untuk Mahasiswa / Civitas) -->
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="/#rekomendasi-user"
        class="font-headline text-base text-near-black hover:text-primary transition-colors duration-200"
      >
        Slot Parkir
      </a>
      <a
        href="/#metode"
        class="font-headline text-base text-near-black hover:text-primary transition-colors duration-200"
      >
        Arsitektur
      </a>
      <a
        href="/#tim"
        class="font-headline text-base text-near-black hover:text-primary transition-colors duration-200"
      >
        Tim Pengembang
      </a>
    </nav>

    <!-- Desktop Right Action: Cek Slot -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="/#rekomendasi-user"
        class="inline-flex items-center gap-1.5 px-5 py-2.5 min-h-[44px] rounded-full bg-primary text-on-primary hover:bg-primary-container shadow-xs transition-colors text-xs font-mono font-semibold cursor-pointer"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">local_parking</span>
        <span>Cek Slot Sekarang</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="btn-mobile-menu"
      type="button"
      class="md:hidden p-2 min-h-[44px] min-w-[44px] rounded-xl text-on-surface hover:bg-surface-container-low transition-colors flex items-center justify-center cursor-pointer"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="mobile-dropdown"
    >
      <span id="menu-icon" class="material-symbols-outlined text-2xl select-none" aria-hidden="true">menu</span>
    </button>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-dropdown"
    class="hidden md:hidden w-full bg-[#fbf9f2] border-b border-outline-variant/20 px-6 py-5 flex-col gap-3 shadow-xl"
  >
    <a
      href="/#rekomendasi-user"
      class="mobile-nav-link font-headline text-lg text-near-black hover:text-primary transition-colors py-2 min-h-[44px] flex items-center"
    >
      Slot Parkir
    </a>
    <a
      href="/#metode"
      class="mobile-nav-link font-headline text-lg text-near-black hover:text-primary transition-colors py-2 min-h-[44px] flex items-center"
    >
      Arsitektur
    </a>
    <a
      href="/#tim"
      class="mobile-nav-link font-headline text-lg text-near-black hover:text-primary transition-colors py-2 min-h-[44px] flex items-center"
    >
      Tim Pengembang
    </a>
    <div class="pt-3 border-t border-outline-variant/15">
      <a
        href="/#rekomendasi-user"
        class="mobile-nav-link w-full bg-primary text-on-primary py-2.5 min-h-[44px] rounded-full font-mono text-xs font-semibold shadow-xs flex items-center justify-center gap-1.5"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">local_parking</span>
        <span>Cek Slot Sekarang</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnMenu = document.getElementById('btn-mobile-menu');
    const dropdown = document.getElementById('mobile-dropdown');
    const menuIcon = document.getElementById('menu-icon');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    let isOpen = false;

    const toggle = () => {
      isOpen = !isOpen;
      btnMenu?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (isOpen) {
        dropdown?.classList.remove('hidden');
        dropdown?.classList.add('flex');
        if (menuIcon) menuIcon.textContent = 'close';
      } else {
        dropdown?.classList.add('hidden');
        dropdown?.classList.remove('flex');
        if (menuIcon) menuIcon.textContent = 'menu';
      }
    };

    btnMenu?.addEventListener('click', toggle);

    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggle();
      });
    });
  });
</script>
