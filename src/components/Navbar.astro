---
// Reusable Navbar - Smart Parking Mobil
// Matching exact design of Image 1 (Prototype UAS Computer Vision)
interface Props {
  title?: string;
  subtitle?: string;
  slotCount?: number;
  rowCount?: number;
  mode?: string;
  tag?: string;
}

const {
  title = "Smart Parking Mobil",
  subtitle = "PROTOTYPE UAS / COMPUTER VISION",
  slotCount = 4,
  rowCount = 1,
  mode = "Mode demonstrasi",
  tag = "UAS"
} = Astro.props;
---

<header class="w-full bg-white border-b border-gray-200/80 sticky top-0 z-40 transition-all">
  <div class="w-full px-4 sm:px-6 md:px-8 py-3 flex items-center justify-between">
    
    <!-- LEFT: Mobile Menu Button + Brand Logo & Title -->
    <div class="flex items-center gap-3">
      <!-- Mobile Sidebar Toggle Hamburger Button -->
      <button
        id="btn-sidebar-toggle"
        type="button"
        class="md:hidden p-2 -ml-2 rounded-xl text-gray-500 hover:text-gray-800 hover:bg-gray-100 focus:outline-hidden transition-colors flex items-center justify-center cursor-pointer"
        aria-label="Buka menu navigasi"
        title="Buka Menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Parking "P" Logo Box -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-hidden">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-[#1c382f] flex items-center justify-center shrink-0 shadow-xs group-hover:bg-[#162d26] transition-colors">
          <span class="text-white font-bold text-lg sm:text-xl tracking-tight leading-none">P</span>
        </div>

        <!-- Title & Subtitle block -->
        <div class="flex flex-col">
          <h1 class="font-bold text-gray-900 text-sm sm:text-base leading-tight tracking-tight group-hover:text-primary transition-colors">
            {title}
          </h1>
          <p class="text-[9px] sm:text-[10px] font-semibold tracking-wider text-gray-400 uppercase mt-0.5 leading-none">
            {subtitle}
          </p>
        </div>
      </a>
    </div>

    <!-- RIGHT: Info text, Divider, Mode demonstrasi badge, UAS badge -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Slot & Row Information Text (visible on tablet/desktop) -->
      <span class="hidden md:inline-block text-xs text-gray-500 font-medium">
        {slotCount} slot &middot; {rowCount} baris parkir
      </span>

      <!-- Vertical Separator Divider Line -->
      <div class="hidden md:block h-4 w-px bg-gray-200 mx-1"></div>

      <!-- Mode Demonstrasi Pill -->
      <div class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full border border-gray-200/90 bg-gray-50/80 text-xs font-medium text-gray-700 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
        <span class="text-[11px] sm:text-xs">{mode}</span>
      </div>

      <!-- UAS Badge -->
      <span class="px-2.5 py-1 rounded-md bg-[#e3eee8] text-[#1e4e3a] text-xs font-bold tracking-wider uppercase shrink-0">
        {tag}
      </span>
    </div>

  </div>
</header>
