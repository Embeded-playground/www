---
---

<header class="w-full bg-[#fbf9f2]/95 backdrop-blur-md sticky top-0 z-50 border-b border-outline-variant/15 transition-all">
  <div class="w-full max-w-screen-2xl mx-auto px-4 sm:px-6 md:px-12 py-4 md:py-6 flex items-center justify-between">
    
    <!-- Brand Title: GoParkir -->
    <a href="/" class="font-headline text-2xl sm:text-3xl font-medium tracking-tight text-primary">
      GoParkir
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#rekomendasi-user" class="font-headline text-lg text-near-black hover:text-primary transition-colors duration-200">
        Recommendation
      </a>
      <a href="#admin-dashboard" class="font-headline text-lg text-near-black hover:text-primary transition-colors duration-200">
        Traffic Analytics
      </a>
      <a href="#metode" class="font-headline text-lg text-near-black hover:text-primary transition-colors duration-200">
        Architecture Flow
      </a>
      <a href="#tim" class="font-headline text-lg text-near-black hover:text-primary transition-colors duration-200">
        The Architects
      </a>
    </nav>

    <!-- Desktop Right Action -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="#rekomendasi-user"
        class="bg-near-black text-surface px-6 py-2.5 rounded-full font-body font-medium shadow-md hover:shadow-lg hover:bg-primary transition-all duration-200 text-sm"
      >
        Check Parking Slots
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="btn-mobile-menu"
      class="md:hidden p-2 rounded-xl text-on-surface hover:bg-surface-container-low transition-colors flex items-center justify-center"
      aria-label="Toggle navigation menu"
    >
      <span id="menu-icon" class="material-symbols-outlined text-2xl select-none">menu</span>
    </button>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-dropdown"
    class="hidden md:hidden w-full bg-[#fbf9f2] border-b border-outline-variant/20 px-6 py-6 flex-col gap-4 shadow-xl"
  >
    <a href="#rekomendasi-user" class="mobile-nav-link font-headline text-xl text-near-black hover:text-primary transition-colors py-1">
      Recommendation
    </a>
    <a href="#admin-dashboard" class="mobile-nav-link font-headline text-xl text-near-black hover:text-primary transition-colors py-1">
      Traffic Analytics
    </a>
    <a href="#metode" class="mobile-nav-link font-headline text-xl text-near-black hover:text-primary transition-colors py-1">
      Architecture Flow
    </a>
    <a href="#tim" class="mobile-nav-link font-headline text-xl text-near-black hover:text-primary transition-colors py-1">
      The Architects
    </a>
    <div class="pt-4 border-t border-outline-variant/15">
      <a
        href="#rekomendasi-user"
        class="mobile-nav-link w-full bg-primary text-on-primary py-3 rounded-full font-body font-medium shadow-md text-center block text-sm"
      >
        Check Parking Slots
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnMenu = document.getElementById('btn-mobile-menu');
    const dropdown = document.getElementById('mobile-dropdown');
    const menuIcon = document.getElementById('menu-icon');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    let isOpen = false;

    const toggle = () => {
      isOpen = !isOpen;
      if (isOpen) {
        dropdown?.classList.remove('hidden');
        dropdown?.classList.add('flex');
        if (menuIcon) menuIcon.textContent = 'close';
      } else {
        dropdown?.classList.add('hidden');
        dropdown?.classList.remove('flex');
        if (menuIcon) menuIcon.textContent = 'menu';
      }
    };

    btnMenu?.addEventListener('click', toggle);

    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggle();
      });
    });
  });
</script>
