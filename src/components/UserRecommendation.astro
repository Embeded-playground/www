---
import CarIllustration from './CarIllustration.astro';
---

<section id="rekomendasi-user" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 scroll-mt-20">
  
  <!-- Header Narasi Mahasiswa/Pengendara -->
  <div class="text-center max-w-3xl mx-auto mb-10">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-headline font-medium text-on-surface tracking-tight">
      Rekomendasi Slot Parkir Real-Time
    </h2>
    <p class="text-on-surface-variant font-body text-sm sm:text-base mt-3 leading-relaxed">
      Pengendara tidak perlu memantau grafik analitik saat berkendara. Sistem Computer Vision secara instan memberikan <strong>satu rekomendasi langsung</strong> ke slot kosong terdekat.
    </p>
  </div>

  <!-- MAIN DRIVER GUIDANCE BOX -->
  <div
    id="driver-guidance-card"
    role="region"
    aria-live="polite"
    class="w-full bg-gradient-to-r from-primary to-primary-container text-on-primary rounded-3xl p-6 sm:p-8 mb-8 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-6 transition-all duration-500"
  >
    <div class="flex items-start sm:items-center gap-4 sm:gap-5">
      <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center shrink-0 shadow-inner">
        <span class="material-symbols-outlined text-3xl sm:text-4xl text-white">near_me</span>
      </div>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[11px] font-mono uppercase tracking-widest bg-white/20 px-2.5 py-0.5 rounded-full font-bold">
            PANDUAN PENGENDARA
          </span>
          <span id="guidance-free-badge" class="text-[11px] font-mono text-white/90">2 Slot Tersedia</span>
        </div>
        <h3 id="guidance-main-title" class="font-headline text-2xl sm:text-4xl font-bold leading-tight">
          "Silakan Menuju ke <span class="underline decoration-white/50">Slot 2</span>"
        </h3>
        <p id="guidance-sub-text" class="text-xs sm:text-sm text-white/85 mt-1">
          Slot optimal: Paling dekat dengan akses pintu masuk lobby Main Hall.
        </p>
      </div>
    </div>

    <!-- Entrance Gate Display -->
    <div class="bg-black/25 backdrop-blur-md px-5 py-3.5 rounded-2xl border border-white/20 shrink-0 self-stretch md:self-auto flex items-center justify-between md:justify-center gap-4">
      <div class="text-left md:text-right">
        <span class="text-[10px] uppercase font-mono text-white/70 block">DISPLAY PINTU GERBANG</span>
        <span id="gate-status-text" class="font-headline text-base sm:text-lg font-bold text-white">SILAKAN MASUK</span>
      </div>
      <span id="gate-status-dot" class="w-3.5 h-3.5 rounded-full bg-slot-available shrink-0"></span>
    </div>
  </div>

  <!-- Live 4-Bay Parking Map -->
  <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 md:p-10 border border-outline-variant/20 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <div>
        <h3 class="font-headline text-2xl sm:text-3xl font-semibold text-on-surface">Denah Area Parkir Main Hall</h3>
        <p class="text-xs sm:text-sm text-on-surface-variant font-body mt-0.5">Status ketersediaan slot kendaraan di area parkir Main Hall</p>
      </div>
      <div class="flex items-center gap-4 text-xs font-medium text-on-surface-variant">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-slot-available"></span>
          <span>Slot Tersedia</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-slot-occupied"></span>
          <span>Slot Terisi</span>
        </span>
      </div>
    </div>

    <!-- 4 Slot Bays Container -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6">
      
      <!-- Slot 1 (Sedan terracotta) -->
      <div
        id="slot-bay-1"
        data-slot-id="1"
        tabindex="0"
        role="button"
        aria-label="Slot 1, status Terisi"
        class="slot-bay cursor-pointer group rounded-2xl p-4 flex flex-col justify-between transition-all duration-500 relative border-2 border-slot-occupied/40 bg-[#fdf8f7] hover:shadow-lg hover:-translate-y-1 overflow-hidden focus-visible:ring-2 focus-visible:ring-primary focus:outline-none"
      >
        <div class="flex items-center justify-between text-xs font-semibold z-10">
          <span class="text-on-surface font-body font-bold">Slot 1</span>
          <span class="roi-tag px-2 py-0.5 rounded text-[10px] bg-slot-occupied/10 text-slot-occupied font-mono font-bold">TERISI</span>
        </div>

        <div class="my-4 h-52 flex items-center justify-center relative overflow-hidden">
          <div class="slot-empty-state hidden w-full h-full rounded-xl border-2 border-dashed border-slot-available/40 flex items-center justify-center bg-slot-available/5 transition-opacity duration-500">
            <span class="text-5xl font-headline font-bold text-slot-available/60 select-none">P</span>
          </div>
          <div class="slot-car-state w-full h-full flex items-center justify-center transition-all duration-700">
            <CarIllustration variant="sedan" color="terracotta" class="w-28 drop-shadow-xl transition-transform duration-500 group-hover:scale-105" />
          </div>
        </div>

        <div class="slot-status-label flex items-center justify-center gap-1.5 text-xs font-semibold text-slot-occupied z-10">
          <span class="w-2 h-2 rounded-full bg-slot-occupied"></span>
          <span class="label-text">Kendaraan Parkir</span>
        </div>
      </div>

      <!-- Slot 2 (Recommended) -->
      <div
        id="slot-bay-2"
        data-slot-id="2"
        tabindex="0"
        role="button"
        aria-label="Slot 2, status Rekomendasi Utama"
        class="slot-bay cursor-pointer group rounded-2xl p-4 flex flex-col justify-between transition-all duration-500 relative border-2 border-slot-available bg-[#f6fcf8] hover:shadow-lg hover:-translate-y-1 overflow-hidden shadow-xs ring-2 ring-slot-available/30 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none"
      >
        <div class="flex items-center justify-between text-xs font-semibold z-10">
          <span class="text-on-surface font-body font-bold">Slot 2</span>
          <span class="roi-tag px-2 py-0.5 rounded text-[10px] bg-slot-available text-white font-mono font-bold">DIREKOMENDASIKAN</span>
        </div>

        <div class="my-4 h-52 flex items-center justify-center relative overflow-hidden">
          <div class="slot-empty-state w-full h-full rounded-xl border-2 border-dashed border-slot-available/40 flex items-center justify-center bg-slot-available/5 transition-opacity duration-500">
            <span class="text-5xl font-headline font-bold text-slot-available select-none">P</span>
          </div>
          <div class="slot-car-state hidden w-full h-full flex items-center justify-center transition-all duration-700">
            <CarIllustration variant="suv" color="teal" class="w-28 drop-shadow-xl transition-transform duration-500 group-hover:scale-105" />
          </div>
        </div>

        <div class="slot-status-label flex items-center justify-center gap-1.5 text-xs font-semibold text-slot-available z-10">
          <span class="w-2 h-2 rounded-full bg-slot-available"></span>
          <span class="label-text">Tersedia &bull; Parkir di Sini</span>
        </div>
      </div>

      <!-- Slot 3 (SUV Slate) -->
      <div
        id="slot-bay-3"
        data-slot-id="3"
        tabindex="0"
        role="button"
        aria-label="Slot 3, status Terisi"
        class="slot-bay cursor-pointer group rounded-2xl p-4 flex flex-col justify-between transition-all duration-500 relative border-2 border-slot-occupied/40 bg-[#fdf8f7] hover:shadow-lg hover:-translate-y-1 overflow-hidden focus-visible:ring-2 focus-visible:ring-primary focus:outline-none"
      >
        <div class="flex items-center justify-between text-xs font-semibold z-10">
          <span class="text-on-surface font-body font-bold">Slot 3</span>
          <span class="roi-tag px-2 py-0.5 rounded text-[10px] bg-slot-occupied/10 text-slot-occupied font-mono font-bold">TERISI</span>
        </div>

        <div class="my-4 h-52 flex items-center justify-center relative overflow-hidden">
          <div class="slot-empty-state hidden w-full h-full rounded-xl border-2 border-dashed border-slot-available/40 flex items-center justify-center bg-slot-available/5 transition-opacity duration-500">
            <span class="text-5xl font-headline font-bold text-slot-available/60 select-none">P</span>
          </div>
          <div class="slot-car-state w-full h-full flex items-center justify-center transition-all duration-700">
            <CarIllustration variant="suv" color="slate" class="w-28 drop-shadow-xl transition-transform duration-500 group-hover:scale-105" />
          </div>
        </div>

        <div class="slot-status-label flex items-center justify-center gap-1.5 text-xs font-semibold text-slot-occupied z-10">
          <span class="w-2 h-2 rounded-full bg-slot-occupied"></span>
          <span class="label-text">Kendaraan Parkir</span>
        </div>
      </div>

      <!-- Slot 4 (Empty - Hatchback Charcoal) -->
      <div
        id="slot-bay-4"
        data-slot-id="4"
        tabindex="0"
        role="button"
        aria-label="Slot 4, status Tersedia"
        class="slot-bay cursor-pointer group rounded-2xl p-4 flex flex-col justify-between transition-all duration-500 relative border-2 border-slot-available/40 bg-[#f6fcf8] hover:shadow-lg hover:-translate-y-1 overflow-hidden focus-visible:ring-2 focus-visible:ring-primary focus:outline-none"
      >
        <div class="flex items-center justify-between text-xs font-semibold z-10">
          <span class="text-on-surface font-body font-bold">Slot 4</span>
          <span class="roi-tag px-2 py-0.5 rounded text-[10px] bg-slot-available/10 text-slot-available font-mono font-bold">TERSEDIA</span>
        </div>

        <div class="my-4 h-52 flex items-center justify-center relative overflow-hidden">
          <div class="slot-empty-state w-full h-full rounded-xl border-2 border-dashed border-slot-available/40 flex items-center justify-center bg-slot-available/5 transition-opacity duration-500">
            <span class="text-5xl font-headline font-bold text-slot-available/60 select-none">P</span>
          </div>
          <div class="slot-car-state hidden w-full h-full flex items-center justify-center transition-all duration-700">
            <CarIllustration variant="hatchback" color="charcoal" class="w-28 drop-shadow-xl transition-transform duration-500 group-hover:scale-105" />
          </div>
        </div>

        <div class="slot-status-label flex items-center justify-center gap-1.5 text-xs font-semibold text-slot-available z-10">
          <span class="w-2 h-2 rounded-full bg-slot-available"></span>
          <span class="label-text">Tersedia &bull; Opsi 2</span>
        </div>
      </div>

    </div>

    <!-- Lane Access -->
    <div class="w-full py-3.5 px-6 rounded-2xl bg-surface-container-low border border-outline-variant/15 flex items-center justify-center gap-3 sm:gap-4 text-xs font-mono text-on-surface-variant">
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
      <span class="tracking-widest uppercase font-semibold">JALUR AKSES KENDARAAN KAMPUS (MAIN HALL)</span>
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
    </div>

  </div>

</section>

<!-- CSS Animasi Mobil Masuk & Keluar -->
<style>
  @keyframes carDriveIn {
    0% {
      transform: translateY(120px) scale(0.85);
      opacity: 0;
    }
    70% {
      transform: translateY(-8px) scale(1.03);
      opacity: 1;
    }
    100% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes carDriveOut {
    0% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
    30% {
      transform: translateY(-10px) scale(1.02);
      opacity: 1;
    }
    100% {
      transform: translateY(140px) scale(0.8);
      opacity: 0;
    }
  }

  :global(.car-enter-active) {
    animation: carDriveIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  :global(.car-leave-active) {
    animation: carDriveOut 0.5s cubic-bezier(0.7, 0, 0.84, 0) forwards !important;
  }
</style>

<!-- Script Logic Rekomendasi Pengendara -->
<script is:inline>
  const userSlotState = {
    1: 1,
    2: 0,
    3: 1,
    4: 0
  };

  function updateRecommendationUI() {
    let freeSlots = [];
    let occCount = 0;

    for (let id = 1; id <= 4; id++) {
      const isOcc = userSlotState[id] === 1;
      if (isOcc) occCount++;
      else freeSlots.push(id);

      const bay = document.getElementById(`slot-bay-${id}`);
      if (!bay) continue;

      const emptyEl = bay.querySelector('.slot-empty-state');
      const carEl = bay.querySelector('.slot-car-state');
      const roiTag = bay.querySelector('.roi-tag');
      const statusLabel = bay.querySelector('.slot-status-label');
      const labelText = statusLabel?.querySelector('.label-text');

      if (isOcc) {
        bay.className = "slot-bay cursor-pointer group rounded-2xl p-4 flex flex-col justify-between transition-all duration-500 relative border-2 border-slot-occupied/40 bg-[#fdf8f7] hover:shadow-lg hover:-translate-y-1 overflow-hidden focus-visible:ring-2 focus-visible:ring-primary focus:outline-none";
        bay.setAttribute('aria-label', `Slot ${id}, status Terisi`);
        emptyEl?.classList.add('hidden');
        if (carEl) {
          carEl.classList.remove('hidden');
          carEl.classList.remove('car-leave-active');
          carEl.classList.add('car-enter-active');
        }
        if (roiTag) {
          roiTag.className = "roi-tag px-2 py-0.5 rounded text-[10px] bg-slot-occupied/10 text-slot-occupied font-mono font-bold";
          roiTag.textContent = "TERISI";
        }
        if (statusLabel) {
          statusLabel.className = "slot-status-label flex items-center justify-center gap-1.5 text-xs font-semibold text-slot-occupied z-10";
          if (labelText) labelText.textContent = "Kendaraan Parkir";
          const dot = statusLabel.querySelector('span');
          if (dot) dot.className = "w-2 h-2 rounded-full bg-slot-occupied";
        }
      } else {
        // Slot Available - Check if this is the #1 recommendation
        const isBest = freeSlots.length > 0 && freeSlots[0] === id;
        
        if (isBest) {
          bay.className = "slot-bay cursor-pointer group rounded-2xl p-4 flex flex-col justify-between transition-all duration-500 relative border-2 border-slot-available bg-[#f6fcf8] hover:shadow-lg hover:-translate-y-1 overflow-hidden ring-2 ring-slot-available/30 focus-visible:ring-2 focus-visible:ring-primary focus:outline-none";
          bay.setAttribute('aria-label', `Slot ${id}, Rekomendasi Utama`);
        } else {
          bay.className = "slot-bay cursor-pointer group rounded-2xl p-4 flex flex-col justify-between transition-all duration-500 relative border-2 border-slot-available/40 bg-[#f6fcf8] hover:shadow-lg hover:-translate-y-1 overflow-hidden focus-visible:ring-2 focus-visible:ring-primary focus:outline-none";
          bay.setAttribute('aria-label', `Slot ${id}, status Tersedia Opsi Cadangan`);
        }

        if (carEl && !carEl.classList.contains('hidden')) {
          carEl.classList.remove('car-enter-active');
          carEl.classList.add('car-leave-active');
          setTimeout(() => {
            carEl.classList.add('hidden');
            carEl.classList.remove('car-leave-active');
            emptyEl?.classList.remove('hidden');
          }, 450);
        } else {
          emptyEl?.classList.remove('hidden');
          carEl?.classList.add('hidden');
        }

        if (roiTag) {
          if (isBest) {
            roiTag.className = "roi-tag px-2 py-0.5 rounded text-[10px] bg-slot-available text-white font-mono font-bold";
            roiTag.textContent = "DIREKOMENDASIKAN";
          } else {
            roiTag.className = "roi-tag px-2 py-0.5 rounded text-[10px] bg-slot-available/10 text-slot-available font-mono font-bold";
            roiTag.textContent = "TERSEDIA";
          }
        }
        if (statusLabel) {
          statusLabel.className = "slot-status-label flex items-center justify-center gap-1.5 text-xs font-semibold text-slot-available z-10";
          if (labelText) labelText.textContent = isBest ? "Tersedia • Parkir di Sini" : "Tersedia • Opsi Cadangan";
          const dot = statusLabel.querySelector('span');
          if (dot) dot.className = "w-2 h-2 rounded-full bg-slot-available";
        }
      }
    }

    // Update Big Guidance Card
    const guideCard = document.getElementById('driver-guidance-card');
    const freeBadge = document.getElementById('guidance-free-badge');
    const mainTitle = document.getElementById('guidance-main-title');
    const subText = document.getElementById('guidance-sub-text');
    const gateText = document.getElementById('gate-status-text');
    const gateDot = document.getElementById('gate-status-dot');

    if (freeSlots.length > 0) {
      const best = freeSlots[0];
      if (guideCard) {
        guideCard.className = "w-full bg-gradient-to-r from-primary to-primary-container text-on-primary rounded-3xl p-6 sm:p-8 mb-8 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-6 transition-all duration-500";
      }
      if (freeBadge) freeBadge.textContent = `${freeSlots.length} Slot Tersedia`;
      if (mainTitle) mainTitle.innerHTML = `"Silakan Menuju ke <span class="underline decoration-white/50">Slot ${best}</span>"`;
      if (subText) subText.textContent = `Slot optimal: Paling dekat dengan akses pintu masuk lobby Main Hall.`;
      if (gateText) gateText.textContent = "SILAKAN MASUK";
      if (gateDot) gateDot.className = "w-3.5 h-3.5 rounded-full bg-slot-available shrink-0";
    } else {
      // Parking Full
      if (guideCard) {
        guideCard.className = "w-full bg-gradient-to-r from-slot-occupied to-[#912417] text-white rounded-3xl p-6 sm:p-8 mb-8 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-6 transition-all duration-500";
      }
      if (freeBadge) freeBadge.textContent = `0 Slot Tersisa`;
      if (mainTitle) mainTitle.innerHTML = `"Area Parkir Penuh (100%)"`;
      if (subText) subText.textContent = `Mohon menunggu kendaraan keluar atau menuju ke area parkir cadangan kampus.`;
      if (gateText) gateText.textContent = "AREA PENUH (ANTRE)";
      if (gateDot) gateDot.className = "w-3.5 h-3.5 rounded-full bg-white shrink-0";
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Slot click and keyboard Enter/Space
    for (let id = 1; id <= 4; id++) {
      const bay = document.getElementById(`slot-bay-${id}`);
      if (!bay) continue;

      const toggleSlot = () => {
        userSlotState[id] = userSlotState[id] === 1 ? 0 : 1;
        updateRecommendationUI();
      };

      bay.addEventListener('click', toggleSlot);
      bay.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleSlot();
        }
      });
    }

    updateRecommendationUI();
  });
</script>
