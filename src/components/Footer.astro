---
---

<footer class="w-full bg-surface-container-low py-16 sm:py-20 md:py-24 rounded-soft z-10 relative border-t border-outline-variant/15 mt-16">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 md:px-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 sm:gap-12 md:gap-16">
        <!-- Brand & Vision Info (GoParkir Murni, Tanpa Card P) -->
        <div class="col-span-1 sm:col-span-2 md:col-span-2 flex flex-col gap-4 sm:gap-6">
            <a
                class="font-headline text-3xl sm:text-4xl font-medium text-on-background tracking-tight"
                href="#"
            >
                GoParkir
            </a>
            <p class="text-base sm:text-lg text-on-surface-variant font-headline italic max-w-md leading-relaxed">
                Computer Vision parking monitoring system designed to guide students and drivers to available bays while empowering campus urban planners.
            </p>

            <!-- Organization Badge -->
            <div class="flex items-center gap-3 pt-2">
                <a
                    href="https://github.com/Embeded-playground"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-near-black text-surface text-xs font-mono font-medium hover:bg-primary transition-colors shadow-xs"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4 fill-current"
                        viewBox="0 0 24 24"
                    >
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                    <span>github.com/Embeded-playground</span>
                </a>
            </div>
        </div>

        <!-- Navigation Menu -->
        <div class="flex flex-col gap-3 sm:gap-4">
            <h4 class="font-body text-xs sm:text-sm font-bold uppercase tracking-widest text-on-background mb-1 sm:mb-2">
                Explore
            </h4>
            <a
                class="font-headline text-base sm:text-lg text-on-surface-variant hover:text-primary transition-colors duration-200"
                href="#rekomendasi-user"
            >
                Parking Recommendation
            </a>
            <a
                class="font-headline text-base sm:text-lg text-on-surface-variant hover:text-primary transition-colors duration-200"
                href="#admin-dashboard"
            >
                Traffic Analytics
            </a>
            <a
                class="font-headline text-base sm:text-lg text-on-surface-variant hover:text-primary transition-colors duration-200"
                href="#metode"
            >
                Data Flow Architecture
            </a>
            <a
                class="font-headline text-base sm:text-lg text-on-surface-variant hover:text-primary transition-colors duration-200"
                href="#tim"
            >
                The Architects
            </a>
        </div>

        <!-- Tech Stack Pill -->
        <div class="flex flex-col gap-3 sm:gap-4">
            <h4 class="font-body text-xs sm:text-sm font-bold uppercase tracking-widest text-on-background mb-1 sm:mb-2">
                Built With
            </h4>

            <div class="flex flex-col gap-2 font-mono text-xs text-on-surface-variant">
                <a
                    href="https://astro.build"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 hover:text-primary transition-colors"
                >
                    <span class="w-2 h-2 rounded-full bg-[#ff5d01]"></span>
                    <span>Astro 7</span>
                </a>
                <a
                    href="https://tailwindcss.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 hover:text-primary transition-colors"
                >
                    <span class="w-2 h-2 rounded-full bg-[#38bdf8]"></span>
                    <span>Tailwind CSS v4</span>
                </a>
                <span class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#00ADD8]"></span>
                    <span>Golang Service</span>
                </span>
                <span class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#3776AB]"></span>
                    <span>Python YOLOv8 OpenCV</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 md:px-12 mt-12 sm:mt-16 pt-8 border-t border-outline-variant/20 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
        <p class="text-on-surface-variant text-xs sm:text-sm font-body">
            &copy; 2026 <strong>GoParkir</strong>. Copyright by{" "}
            <a
                href="https://github.com/Embeded-playground"
                target="_blank"
                class="text-primary hover:underline font-semibold"
            >
                Embeded-playground
            </a>
            . All rights reserved.
        </p>

        <div class="flex items-center gap-2 text-xs font-mono text-on-surface-variant">
            <span>Built with</span>
            <a
                href="https://astro.build"
                target="_blank"
                class="font-bold text-on-surface hover:text-primary transition-colors bg-surface-container-highest px-2 py-0.5 rounded"
            >
                <span>Astro</span>
            </a>
            <span>and With Love</span>
        </div>
    </div>
</footer>
