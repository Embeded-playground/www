---
interface Props {
  title: string;
  value: string | number;
  unit?: string;
  subtitle?: string;
  icon?: string;
  variant?: 'default' | 'primary' | 'tertiary' | 'available' | 'occupied' | 'warning';
  trend?: string;
  trendDirection?: 'up' | 'down' | 'neutral';
  trendLabel?: string;
  class?: string;
}

const {
  title,
  value,
  unit,
  subtitle,
  icon,
  variant = 'default',
  trend,
  trendDirection = 'neutral',
  trendLabel,
  class: className = '',
} = Astro.props;

const iconVariantClasses = {
  default: 'bg-surface-container-high text-on-surface-variant',
  primary: 'bg-primary/10 text-primary',
  tertiary: 'bg-tertiary/10 text-tertiary',
  available: 'bg-slot-available/10 text-slot-available',
  occupied: 'bg-slot-occupied/10 text-slot-occupied',
  warning: 'bg-amber-500/10 text-amber-700',
};

const trendVariantClasses = {
  up: 'text-slot-available bg-slot-available/10',
  down: 'text-slot-occupied bg-slot-occupied/10',
  neutral: 'text-on-surface-variant bg-surface-container-high',
};

const trendIconMap = {
  up: 'trending_up',
  down: 'trending_down',
  neutral: 'trending_flat',
};
---

<div
  class={`bg-surface-container-lowest rounded-2xl sm:rounded-3xl p-4 sm:p-5 md:p-6 border border-outline-variant/15 shadow-xs transition-shadow hover:shadow-md flex flex-col justify-between ${className}`}
>
  <!-- Card Header: Title & Icon -->
  <div class="flex items-start justify-between gap-2.5 mb-2 sm:mb-3">
    <div class="space-y-0.5 min-w-0">
      <span class="text-xs sm:text-sm font-medium text-on-surface-variant font-body line-clamp-2">
        {title}
      </span>
      {subtitle && (
        <p class="text-[11px] text-on-surface-variant/80 font-mono line-clamp-1">
          {subtitle}
        </p>
      )}
    </div>

    {icon && (
      <div
        class={`w-9 h-9 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl flex items-center justify-center shrink-0 ${iconVariantClasses[variant]}`}
      >
        <span class="material-symbols-outlined text-lg sm:text-xl">{icon}</span>
      </div>
    )}
  </div>

  <!-- Card Body: Large Value & Unit -->
  <div class="mt-1 sm:mt-2">
    <div class="flex items-baseline gap-1.5 flex-wrap">
      <span class="font-headline text-2xl sm:text-3xl lg:text-4xl font-bold text-on-surface tracking-tight">
        {value}
      </span>
      {unit && (
        <span class="text-xs sm:text-sm font-mono text-on-surface-variant font-medium">
          {unit}
        </span>
      )}
    </div>

    <!-- Optional Trend Badge or Custom Footer slot -->
    {(trend || Astro.slots.has('trend')) && (
      <div class="mt-2.5 sm:mt-3 pt-2 sm:pt-2.5 border-t border-outline-variant/10 flex items-center gap-1.5 sm:gap-2 text-xs flex-wrap">
        {trend && (
          <span
            class={`inline-flex items-center gap-1 font-mono font-bold text-[11px] px-2 py-0.5 rounded-full ${trendVariantClasses[trendDirection]}`}
          >
            <span class="material-symbols-outlined text-sm leading-none">
              {trendIconMap[trendDirection]}
            </span>
            {trend}
          </span>
        )}
        {trendLabel && (
          <span class="text-on-surface-variant/80 text-[11px] font-mono truncate">
            {trendLabel}
          </span>
        )}
        <slot name="trend" />
      </div>
    )}
  </div>

  <slot />
</div>
