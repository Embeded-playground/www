---
interface Props {
  title: string;
  description: string;
  icon?: string;
  actionText: string;
  actionHref?: string;
  actionId?: string;
  variant?: 'primary' | 'surface' | 'info';
  class?: string;
}

const {
  title,
  description,
  icon = 'tune',
  actionText,
  actionHref,
  actionId,
  variant = 'surface',
  class: className = '',
} = Astro.props;

const variantStyles = {
  primary: 'bg-primary/10 border-primary/20 text-on-surface',
  surface: 'bg-surface-container-lowest border-outline-variant/15 text-on-surface',
  info: 'bg-tertiary/10 border-tertiary/20 text-on-surface',
};
---

<div
  class={`p-5 rounded-3xl border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs ${variantStyles[variant]} ${className}`}
>
  <div class="flex items-start gap-3.5">
    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-xl" aria-hidden="true">{icon}</span>
    </div>
    <div>
      <h4 class="font-headline font-bold text-base text-on-surface">
        {title}
      </h4>
      <p class="text-xs text-on-surface-variant font-body mt-0.5">
        {description}
      </p>
    </div>
  </div>

  {actionHref ? (
    <a
      href={actionHref}
      id={actionId}
      class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 min-h-[44px] rounded-xl bg-primary text-on-primary text-xs font-mono font-medium hover:bg-primary-container transition-colors shrink-0 shadow-2xs cursor-pointer"
    >
      <span>{actionText}</span>
      <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
    </a>
  ) : (
    <button
      type="button"
      id={actionId}
      class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 min-h-[44px] rounded-xl bg-primary text-on-primary text-xs font-mono font-medium hover:bg-primary-container transition-colors shrink-0 shadow-2xs cursor-pointer"
    >
      <span>{actionText}</span>
      <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
    </button>
  )}
</div>
