---
interface Props {
  title: string;
  description?: string;
  icon: string;
  href?: string;
  id?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'surface';
  badge?: string;
  class?: string;
}

const {
  title,
  description,
  icon,
  href,
  id,
  variant = 'surface',
  badge,
  class: className = '',
} = Astro.props;

const variantStyles = {
  primary: 'bg-primary text-on-primary hover:bg-primary-container border-transparent',
  secondary: 'bg-secondary text-on-primary hover:opacity-90 border-transparent',
  outline: 'bg-transparent text-on-surface hover:bg-surface-container-high border-outline-variant/30',
  surface: 'bg-surface-container-lowest text-on-surface hover:border-primary/40 border-outline-variant/15 hover:shadow-2xs',
};
---

{href ? (
  <a
    href={href}
    id={id}
    class={`group p-4 rounded-2xl border transition-all flex items-start gap-3.5 text-left cursor-pointer min-h-[44px] ${variantStyles[variant]} ${className}`}
  >
    <div class="w-10 h-10 rounded-xl bg-surface-container-high/80 group-hover:bg-primary/10 group-hover:text-primary transition-colors flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-xl" aria-hidden="true">{icon}</span>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2">
        <h4 class="font-headline font-semibold text-sm truncate">
          {title}
        </h4>
        {badge && (
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-primary/10 text-primary font-bold">
            {badge}
          </span>
        )}
      </div>
      {description && (
        <p class="text-xs text-on-surface-variant font-body mt-0.5 line-clamp-1">
          {description}
        </p>
      )}
    </div>

    <span class="material-symbols-outlined text-base text-on-surface-variant/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all self-center" aria-hidden="true">
      chevron_right
    </span>
  </a>
) : (
  <button
    type="button"
    id={id}
    class={`group p-4 rounded-2xl border transition-all flex items-start gap-3.5 text-left cursor-pointer min-h-[44px] w-full ${variantStyles[variant]} ${className}`}
  >
    <div class="w-10 h-10 rounded-xl bg-surface-container-high/80 group-hover:bg-primary/10 group-hover:text-primary transition-colors flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-xl" aria-hidden="true">{icon}</span>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2">
        <h4 class="font-headline font-semibold text-sm truncate">
          {title}
        </h4>
        {badge && (
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-primary/10 text-primary font-bold">
            {badge}
          </span>
        )}
      </div>
      {description && (
        <p class="text-xs text-on-surface-variant font-body mt-0.5 line-clamp-1">
          {description}
        </p>
      )}
    </div>

    <span class="material-symbols-outlined text-base text-on-surface-variant/50 group-hover:text-primary group-hover:translate-x-0.5 transition-all self-center" aria-hidden="true">
      chevron_right
    </span>
  </button>
)}
