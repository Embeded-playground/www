---
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  subtitle?: string;
  showSearch?: boolean;
  searchPlaceholder?: string;
  liveStatusText?: string;
  liveStatusVariant?: 'success' | 'warning' | 'danger';
  class?: string;
}

const {
  title,
  subtitle,
  showSearch = true,
  searchPlaceholder = 'Search bay, license plate, or camera ID...',
  liveStatusText = 'CV Vision Online (30 FPS)',
  liveStatusVariant = 'success',
  class: className = '',
} = Astro.props;
---

<header
  class={`h-16 px-4 sm:px-6 md:px-8 bg-surface-container-lowest border-b border-outline-variant/15 flex items-center justify-between gap-4 sticky top-0 z-20 ${className}`}
>
  <!-- Left: Title & Subtitle or Breadcrumbs -->
  <div class="flex items-center gap-3 min-w-0">
    <!-- Mobile Hamburger Button Trigger (dispatches custom event for shell) -->
    <button
      id="dashboard-sidebar-toggle"
      type="button"
      class="lg:hidden min-w-[44px] min-h-[44px] rounded-xl text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors flex items-center justify-center cursor-pointer"
      aria-label="Toggle Navigation Sidebar"
    >
      <span class="material-symbols-outlined text-xl">menu</span>
    </button>

    <div class="truncate">
      <h1 class="font-headline font-bold text-base sm:text-lg text-on-surface truncate leading-tight">
        {title}
      </h1>
      {subtitle && (
        <p class="text-[11px] font-mono text-on-surface-variant truncate hidden sm:block">
          {subtitle}
        </p>
      )}
    </div>
  </div>

  <!-- Center: Search Input (Optional) -->
  {showSearch && (
    <div class="hidden md:flex items-center flex-1 max-w-md mx-4">
      <div class="relative w-full">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant/70 text-lg pointer-events-none">
          search
        </span>
        <input
          type="search"
          placeholder={searchPlaceholder}
          class="w-full pl-9 pr-4 py-1.5 rounded-xl bg-surface-container-low border border-outline-variant/20 text-xs font-body text-on-surface placeholder:text-on-surface-variant/60 focus:outline-hidden focus:border-primary/50 transition-colors"
        />
      </div>
    </div>
  )}

  <!-- Right: Actions & Status -->
  <div class="flex items-center gap-2.5 shrink-0">
    {liveStatusText && (
      <StatusBadge
        label={liveStatusText}
        variant={liveStatusVariant}
        dot={true}
        size="sm"
        class="hidden sm:inline-flex"
      />
    )}

    <slot name="actions" />

    <!-- Notification Button -->
    <button
      type="button"
      class="min-w-[44px] min-h-[44px] rounded-xl text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors relative flex items-center justify-center cursor-pointer"
      aria-label="Notifications"
    >
      <span class="material-symbols-outlined text-xl">notifications</span>
      <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-slot-occupied"></span>
    </button>
  </div>
</header>
